{
  "kind": "collectionType",
  "collectionName": "products",
  "info": {
    "singularName": "product",
    "pluralName": "products",
    "displayName": "Product"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "productName": {
      "type": "string"
    },
    "slug": {
      "type": "uid",
      "targetField": "productName"
    },
    "size": {
      "type": "enum",
      
    "description": {
      "type": "text"
    },
    "images": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "brand":{
      "type": "text"
    }

    "active": {
      "type": "boolean",
      "required": false,
      "default": true
    },
    
    "size": {
     "type": "enumeration",
      "enum": [
      "XS",
      "S",
      "M",
      "L",
      "XL",
      "XXL"]
    },
    "origin": {
      "type": "enumeration",
      "enum": [
        "Asia",
        "Africa",
        "America",
        "Europa"
      ]
    },
    "isFeatured": {
      "type": "boolean"
    },
    "category": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::category.category"
    }
  }
}
